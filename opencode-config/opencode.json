{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CONFIG_RULES.md"],
  "mcp": {
    "obsidian-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:27124/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LOCAL_MCP_TOKEN}"
      }
    }
  },
  "permission": {
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "git stash list": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "gh release *": "allow",
      "gh auth status": "allow",
      "ls": "allow",
      "dir": "allow",
      "Get-ChildItem": "allow",
      "Get-Content": "allow",
      "Get-Date": "allow",
      "Test-Path": "allow",
      "Copy-Item": "allow",
      "Remove-Item": "ask",
      "Move-Item": "ask",
      "Rename-Item": "ask",
      "New-Item": "allow",
      "Set-Content": "allow",
      "Add-Content": "allow",
      "Get-Process": "allow",
      "Get-Service": "allow",
      "Invoke-WebRequest": "allow",
      "curl *": "allow",
      "cat": "allow",
      "type": "allow",
      "which": "allow",
      "where": "allow",
      "npm list": "allow",
      "npm list -g": "allow",
      "npm --version": "allow",
      "node --version": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "uv --version": "allow",
      "uvx --version": "allow",
      "npx --version": "allow",
      "pip --version": "allow",
      "pwd": "allow",
      "echo": "allow",
      "hostname": "allow",
      "whoami": "allow",
      "env": "allow",
      "printenv": "allow",
      "*": "ask"
    }
  }
}