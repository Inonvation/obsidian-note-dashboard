{
  "$schema": "https://opencode.ai/config.json",
  "name": "obsidian-note-dashboard",
  "skills": [
    ".opencode/skills/obsidian-plugin-release/SKILL.md",
    ".opencode/skills/obsidian-plugin-dev/SKILL.md",
    ".opencode/skills/obsidian-plugin-test/SKILL.md"
  ],
  "permission": {
    "bash": {
      "git *": "allow",
